# Normalise line endings. Shell scripts must stay LF: a CRLF shebang
# makes the script unrunnable on Linux ("bad interpreter").
* text=auto eol=lf

*.sh            text eol=lf
config.example  text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.service       text eol=lf
*.timer         text eol=lf

# Never touch real config files if someone keeps one around.
config          -text

# fnOS 安装包：manifest 必须是 CRLF，生命周期脚本必须是 LF。
# （`* text=auto eol=lf` 会把 manifest 归一成 LF，克隆后重新打包会装不上）
fnos/manifest   text eol=crlf
fnos/cmd/*      text eol=lf
